# Kompound VideoCutter Environment Configuration

# Server Configuration
PORT=8080

# Deployment Mode
# Set to "development" for local development without SSL/nginx (direct Go server access)
# Set to "production" for production mode with nginx and SSL certificates
COMPOSE_PROFILES=production

# File Storage Configuration
# HOST_UPLOAD_DIR specifies where uploaded files are stored on your host machine
# when running with Docker.
HOST_UPLOAD_DIR=./temp

# Optional: Logging Level (debug, info, warn, error)
LOG_LEVEL=error

# Optional: HTTP Request Logging (true/false/none)
# Set to "false" or "none" to disable HTTP request logs
LOG_REQUESTS=false

# Maximum file size (in bytes) - Default: 10GB
# Adjusts both application file size limits and nginx client_max_body_size
MAX_FILE_SIZE=10737418240

# Nginx client_max_body_size - Should be larger than MAX_FILE_SIZE for overhead
# Format: number followed by unit (K, M, G) - Default: 15G
MAX_BODY_SIZE=15G

# Optional: FFmpeg binary path (if not in PATH)
# FFMPEG_PATH=/usr/bin/ffmpeg

# Optional: FFprobe binary path (if not in PATH)
# FFPROBE_PATH=/usr/bin/ffprobe

# Domain Configuration
# DOMAIN specifies the domain name used for SSL certificates and nginx configuration
DOMAIN=videocutter.local

# SSL/Cloudflare Configuration
# SSL_EMAIL specifies the email address for SSL certificate registration
# This will default to admin@${DOMAIN} if not specified
SSL_EMAIL=admin@your-domain.com

# JWT Configuration
# IMPORTANT: Generate a secure secret using one of these methods:
#   - Linux/macOS: head -c32 /dev/urandom | base64
#   - Windows PowerShell: [System.Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=
